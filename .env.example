# FedEx Developer Portal project credentials
# https://developer.fedex.com/ -> My Projects -> project -> API key / secret
FEDEX_CLIENT_ID=your_api_key
FEDEX_CLIENT_SECRET=your_api_secret

# FedEx account number used when a request omits one.
# The sandbox portal gives you a test account number you can use here.
FEDEX_ACCOUNT_NUMBER=

# sandbox (default) or production
FEDEX_ENVIRONMENT=sandbox

# Optional overrides
# FEDEX_BASE_URL=https://apis-sandbox.fedex.com
# FEDEX_LOCALE=en_US
# FEDEX_TIMEOUT_MS=30000
# PORT=4000
# Public origin used to build clickable label links (LAN, tunnel, reverse proxy)
# PUBLIC_BASE_URL=http://localhost:4000
