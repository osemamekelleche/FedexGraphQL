{
  "name": "fedex-graphql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GraphQL wrapper around the FedEx Ship API (REST v1)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "predev": "npm run build:frontend",
    "dev": "tsx watch src/server.ts",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build": "npm run build:frontend && tsc -p tsconfig.build.json",
    "build:exe": "node scripts/build-sea.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "generate": "node scripts/generate-fedex-types.mjs",
    "schema": "npm run generate && tsx scripts/print-schema.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "graphql": "^17.1.0",
    "graphql-yoga": "^5.24.6"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@graphiql/toolkit": "^1.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "graphiql": "^6.0.1",
    "monaco-editor": "^0.57.0",
    "monaco-graphql": "^2.0.1",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
